# Copy to .env and fill in. EXPO_PUBLIC_* vars are embedded in the app bundle —
# only put PUBLISHABLE values here, never secret keys.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: enables the AI Insight card on the dashboard
EXPO_PUBLIC_GEMINI_API_KEY=

# Server-side secrets (set with `supabase secrets set`, NOT in this file):
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRO_PRICE_ID
